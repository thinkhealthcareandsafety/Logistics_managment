# Server
PORT=5000
NODE_ENV=development
# Also the origin used to build the tracking and feedback links we send customers -
# set this to your real public URL in production or customers get localhost links.
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/logistics-tracker

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=lt_token
# Only emails on these domains can create an account (comma-separated). Signed-in
# users see the shared sales pipeline, so keep this to your own staff domains.
SIGNUP_ALLOWED_DOMAINS=thinkhealth.in

# TrackingMore (https://www.trackingmore.com/ -> dashboard -> API keys)
# Covers all standard carriers AND Shree Maruti Courier (carrier code: shreemaruticourier)
TRACKINGMORE_API_KEY=your-trackingmore-api-key
TRACKINGMORE_BASE_URL=https://api.trackingmore.com/v4

# Background refresh job
# Cron expression for how often shipments are auto-refreshed (default: every 15 minutes)
REFRESH_CRON=*/15 * * * *
REFRESH_CONCURRENCY=5
# Minimum minutes between refreshes for the same shipment (avoids hammering the API)
MIN_REFRESH_INTERVAL_MINUTES=10

# Email notifications (SMTP - e.g. SendGrid, Mailgun, Gmail app password, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="ThinkHealth Logistics <notifications@example.com>"

# WhatsApp notifications via Gupshup (https://www.gupshup.io/ -> WhatsApp API app)
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_SOURCE_NUMBER=91xxxxxxxxxx
GUPSHUP_APP_NAME=your-gupshup-app-name

# Public address of this API (no trailing slash). Zoho redirects back to it after
# sign-in and calls its webhook, so in production it must be reachable from the internet.
SERVER_URL=http://localhost:5000

# "Scan label": Google Gemini reads a photo of a shipping label / booking slip into the
# Add shipment form (https://aistudio.google.com -> Get API key). If blank, the button
# stays and tells the user it isn't set up yet.
GEMINI_API_KEY=
# First model tried; if Google reports it busy the reader falls back to
# gemini-3-flash-preview, then gemini-flash-latest.
GEMINI_MODEL=gemini-3.5-flash

# Zoho Books stock sync. In the Zoho API Console for your region (India:
# https://api-console.zoho.in) add a "Server-based Application" with the redirect URI
#   <SERVER_URL>/api/integrations/zoho/callback
# then connect from Stock -> "Connect Zoho Books".
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data centre: in (India), com, eu, au, jp, uk, sa, ca
ZOHO_DC=in
# How often stock catches up with Zoho when no webhook arrives (default every 15 min)
ZOHO_SYNC_CRON=*/15 * * * *
# Optional: key that encrypts the stored Zoho token (defaults to one derived from JWT_SECRET)
ZOHO_TOKEN_KEY=

# Push-ingestion endpoint (POST /api/ingest/shipments): lets an upstream system (order
# system, booking API, Zapier, etc.) register a new shipment without a user login.
# INGEST_OWNER_EMAIL must match an existing user account - ingested shipments are
# attributed to that user.
INGEST_API_KEY=replace-with-a-long-random-string
INGEST_OWNER_EMAIL=demo@thinkhealth.in
